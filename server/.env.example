FLOW_DB_DRIVER=pgsql
FLOW_DB_HOST=127.0.0.1
FLOW_DB_PORT=5432
FLOW_DB_USER=postgres
FLOW_DB_PASS=postgres
FLOW_DB_NAME=flowdb
FLOW_DB_AUTO_INIT=true

FLOW_REGISTRY_EXPIRY=12s
FLOW_REGISTRY_KEEPALIVE_INTERVAL=10s
FLOW_REGISTRY_SWEEP_INTERVAL=5s
FLOW_REGISTRY_SWEEP_BATCH=200
FLOW_REGISTRY_WATCH_INTERVAL=500ms
FLOW_REGISTRY_WATCH_BATCH_SIZE=200
FLOW_REGISTRY_WATCH_MAX_RETRY_BACKOFF=10s

FLOW_OTEL_ENABLED=true
FLOW_OTEL_SERVICE_NAME=flow-server
FLOW_OTEL_ENDPOINT=127.0.0.1:4317
FLOW_OTEL_PROTOCOL=grpc
FLOW_OTEL_SAMPLER_RATIO=1.0

# 客户端面（task / worker / schedule）的 api_key 鉴权，默认关闭。打开前先把客户端升级到会带 key 的版本。
FLOW_API_AUTH_ENABLED=false

# 定时回调调度器。删掉整个 [scheduler] 段（或这些变量）则不启动调度器。
FLOW_SCHEDULER_TICK_INTERVAL=1s
FLOW_SCHEDULER_SCAN_BATCH=100
FLOW_SCHEDULER_DELIVER_CONCURRENCY=64
FLOW_SCHEDULER_HTTP_TIMEOUT=10s
# 必须大于 FLOW_SCHEDULER_HTTP_TIMEOUT
FLOW_SCHEDULER_LEASE_DURATION=30s
FLOW_SCHEDULER_LATENESS_TOLERANCE=30s
FLOW_SCHEDULER_RETRY_JITTER_RATIO=0.2
# 快重试是「首发之后」的间隔列表，共 len+1 次尝试；死信慢重试的条数就是慢重试次数
FLOW_SCHEDULER_FAST_RETRY_INTERVALS=3s,10s
FLOW_SCHEDULER_DEAD_LETTER_INTERVALS=1m,5m,30m